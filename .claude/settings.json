{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/graphify\" hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/graphify\" hook-guard read"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv tool upgrade graphifyy >/dev/null 2>&1 || true",
            "async": true,
            "statusMessage": "Checking graphify for updates..."
          }
        ]
      }
    ]
  }
}